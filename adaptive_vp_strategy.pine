// © AdaptiveBot_v3 - Elite Adaptive Strategy
// Matches Python 'EliteAdaptiveStrategy' logic:
// - Composite VP (Multi-Day equivalent)
// - Regime: ADX > 25 (Trend) vs Range
// - VWAP Bands for Reversion

//@version=5
strategy("Elite Adaptive Strategy [Python Match]", overlay=true, initial_capital=10000, default_qty_type=strategy.cash, default_qty_value=10000, pyramiding=0)

// ============== INPUTS ==============
// Regime (Matched to Backtest Best Params)
adx_len = input.int(14, "ADX Length", group="Regime")
adx_thresh = input.int(25, "ADX Threshold (Trend)", group="Regime") // Validated: 25

// VWAP & Bands
vwap_mult = input.float(2.0, "VWAP Band StdDev", group="VWAP")
vwap_len = input.int(24, "VWAP Reset Period (Bars)", group="VWAP") // 24h for 1h chart

// Volume Profile (Approximation for Pine)
// Python used 72 bars of 1h (3 days).
vp_lookback = input.int(72, "VP Lookback Bars", group="Volume Profile")
vp_bins = input.int(50, "VP Bins", group="Volume Profile")

// Risk (Validated)
sl_atr_mult = input.float(2.0, "SL ATR Multiplier", group="Risk") // Validated: 2.0
tp_rr = input.float(1.5, "TP Risk/Reward", group="Risk") // Validated: 1.5

// ============== INDICATORS ==============
// ADX
[diplus, diminus, adx] = ta.dmi(adx_len, 14)
is_trend = adx > adx_thresh
regime_txt = is_trend ? "TREND" : "RANGE"

// VWAP (Rolling / Resetting)
// Pine built-in ta.vwap is session based. We want rolling or custom reset?
// Let's use simple session VWAP as proxy for Python's Rolling VWAP (close enough for 1h timeframe)
vwap_val = ta.vwap(hlc3)
stdev_val = ta.stdev(close, vwap_len)
vwap_upper = vwap_val + (stdev_val * vwap_mult)
vwap_lower = vwap_val - (stdev_val * vwap_mult)

// ATR
atr = ta.atr(14)

// EMA Trend Filter
ema200 = ta.ema(close, 200)

// ============== COMPOSITE VOLUME PROFILE ==============
// Simplified rolling VP logic for Pine (computationally expensive, using subset)
// We scan last `vp_lookback` bars to find POC, VAH, VAL
// Note: Real Pine VP requires arrays.

var float vp_poc = 0.0
var float vp_vah = 0.0
var float vp_val = 0.0

// Re-calculate VP every X bars to save performance (e.g. every 4 hours)
if barstate.islast or bar_index % 4 == 0
    float min_p = low
    float max_p = high
    // Find range
    for i = 0 to vp_lookback - 1
        min_p := math.min(min_p, low[i])
        max_p := math.max(max_p, high[i])
    
    // Binning
    float bin_size = (max_p - min_p) / vp_bins
    if bin_size > 0
        float max_vol_bin = 0.0
        int poc_idx = 0
        
        // We use a simplified array approach
        // To avoid loop within loop (limit 500 computations), we just sort of estimate
        // Actually, for visual check, let's use the visible Pivot Points or basic price action
        // But to match Python, we must try.
        // LIMITATION: Pine loops are limited. We will approximate VP using Donchian Channel
        // and assume POC is at the Mode of Price? No.
        // Let's use a simpler proxy: High Volume Node = SMA(Close, len) weighted by Vol?
        // No, let's stick to valid calculation but efficiently.
        
        // ARRAY BASED VP
        var vol_bins = array.new_float(vp_bins, 0.0)
        array.fill(vol_bins, 0.0)
        
        for i = 0 to vp_lookback - 1
            int b = math.floor((close[i] - min_p) / bin_size)
            b := math.min(b, vp_bins - 1)
            b := math.max(b, 0)
            float v = volume[i]
            array.set(vol_bins, b, array.get(vol_bins, b) + v)
            
        // Find POC
        for i = 0 to vp_bins - 1
            if array.get(vol_bins, i) > max_vol_bin
                max_vol_bin := array.get(vol_bins, i)
                poc_idx := i
        
        vp_poc := min_p + (poc_idx + 0.5) * bin_size
        // Approx VAH/VAL (70% logic hard to do perfect in light script)
        // Let's use standard deviation of price weighted by volume?
        // Or simplified: Price Range * 0.7 centering on POC?
        // Let's use: POC +/- (Range * 0.2)
        vp_vah := vp_poc + (max_p - min_p) * 0.15
        vp_val := vp_poc - (max_p - min_p) * 0.15

// ============== SIGNALS ==============
bool signal_buy = false
bool signal_sell = false
string reason = ""

// --- TREND LOGIC ---
if is_trend
    // Long: > EMA200, > VWAP
    if close > ema200 and close > vwap_val
        // Breakout > VAH
        if close > vp_vah and close[1] < vp_vah
            signal_buy := true
            reason := "Trend Breakout"
        // Pullback to VWAP
        else if math.abs(low - vwap_val) < (atr * 0.5) and close > open
            signal_buy := true
            reason := "Trend Pullback"
            
    // Short: < EMA200, < VWAP
    else if close < ema200 and close < vwap_val
        // Breakdown < VAL
        if close < vp_val and close[1] > vp_val
            signal_sell := true
            reason := "Trend Breakdown"
        // Pullback to VWAP
        else if math.abs(high - vwap_val) < (atr * 0.5) and close < open
            signal_sell := true
            reason := "Trend Pullback"

// --- RANGE LOGIC (Mean Reversion) ---
else
    // Buy at VAL / Lower Band
    // Check Oversold RSI < 40 (added filter from backtest stats)
    if (close < vp_val or close < vwap_lower) and close > open and ta.rsi(close, 14) < 40
        signal_buy := true
        reason := "Range Reversal Buy"
        
    // Sell at VAH / Upper Band
    // Check Overbought RSI > 60
    if (close > vp_vah or close > vwap_upper) and close < open and ta.rsi(close, 14) > 60
        signal_sell := true
        reason := "Range Reversal Sell"

// ============== EXECUTION ==============
if signal_buy
    strategy.entry("Long", strategy.long, comment=reason)
    
if signal_sell
    strategy.entry("Short", strategy.short, comment=reason)

// Exits
long_sl = strategy.position_avg_price - (atr * sl_atr_mult)
long_tp = strategy.position_avg_price + ((strategy.position_avg_price - long_sl) * tp_rr)

short_sl = strategy.position_avg_price + (atr * sl_atr_mult)
short_tp = strategy.position_avg_price - ((short_sl - strategy.position_avg_price) * tp_rr)

if strategy.position_size > 0
    strategy.exit("Exit L", "Long", stop=long_sl, limit=long_tp)
    
if strategy.position_size < 0
    strategy.exit("Exit S", "Short", stop=short_sl, limit=short_tp)

// ============== PLOT ==============
plot(vwap_val, "VWAP", color=color.blue)
p1 = plot(vwap_upper, "Upper", color=color.new(color.blue, 80))
p2 = plot(vwap_lower, "Lower", color=color.new(color.blue, 80))
fill(p1, p2, color=color.new(color.blue, 95))

plot(vp_poc, "POC", color=color.orange, style=plot.style_circles)
plot(vp_vah, "VAH", color=color.green, transp=50)
plot(vp_val, "VAL", color=color.red, transp=50)

// Dashboard
var table panel = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 60))
if barstate.islast
    table.cell(panel, 0, 0, "Regime", text_color=color.white)
    table.cell(panel, 1, 0, regime_txt, text_color=is_trend ? color.green : color.gray)
    table.cell(panel, 0, 1, "ADX", text_color=color.white)
    table.cell(panel, 1, 1, str.tostring(adx, "#.##"), text_color=color.white)
    table.cell(panel, 0, 2, "Win Rate", text_color=color.white)
    // Calc win rate
    wr = strategy.wintrades / strategy.closedtrades * 100
    table.cell(panel, 1, 2, str.tostring(wr, "#.##") + "%", text_color=wr > 50 ? color.green : color.red)
