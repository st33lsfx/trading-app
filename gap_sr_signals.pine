//@version=5
indicator("SmartZone Algo", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

//=====================================================================================================================
// 1. INPUTS
//=====================================================================================================================
// --- Liquidity ---
LIQ_GRP         = "Liquidity"
showPivotLiq    = input.bool(true,  "Pivot Liquidity",          group=LIQ_GRP)
pivotLen        = input.int(5,      "Pivot Length",             minval=2, maxval=30,    group=LIQ_GRP)
minSwingSize    = input.float(1.0,  "Min Swing Size (ATR)",    minval=0.0, maxval=5.0, step=0.1, group=LIQ_GRP, tooltip="0 = no filter, 1.0 = recommended")
showDaily       = input.bool(true,  "Daily H/L",               group=LIQ_GRP)
showWeekly      = input.bool(false, "Weekly H/L",              group=LIQ_GRP)
showMonthly     = input.bool(false, "Monthly H/L",             group=LIQ_GRP)

// --- Structure ---
STR_GRP         = "Structure"
showStructure   = input.bool(true,  "Show BOS/CHoCH",          group=STR_GRP)
structLen       = input.int(5,      "Structure Pivot Length",   minval=2, maxval=30,    group=STR_GRP)
showM2          = input.bool(true,  "Show M2 Zones",           group=STR_GRP)
htfM2           = input.timeframe("60", "M2 Higher TF",        group=STR_GRP)
maxStructLabels = input.int(20,     "Max BOS/CHoCH Labels",    minval=5, maxval=60,    group=STR_GRP)

// --- AOI ---
AOI_GRP         = "AOI"
showAOI         = input.bool(true,  "Show AOI Zones",          group=AOI_GRP)
showFVG         = input.bool(true,  "Include FVG in AOI",      group=AOI_GRP)
fvgConfluence   = input.bool(true,  "FVG Only With Confluence", group=AOI_GRP, tooltip="FVG becomes AOI only if near M2 or liquidity level")
minFVGSize      = input.float(0.5,  "Min FVG Size (ATR)",      minval=0.1, maxval=2.0, step=0.1, group=AOI_GRP, tooltip="Filter tiny gaps")
maxAOI          = input.int(4,      "Max AOI Zones",           minval=1, maxval=12,    group=AOI_GRP)
aoiAtrMult      = input.float(0.2,  "AOI Thickness (ATR)",     minval=0.05, maxval=1.0, step=0.05, group=AOI_GRP)

// --- Session ---
SES_GRP         = "Session"
showSession     = input.bool(true,  "Show Session Envelope",   group=SES_GRP)
sesStartH       = input.int(8,      "Session Start Hour",      minval=0, maxval=23,    group=SES_GRP)
sesStartM       = input.int(0,      "Session Start Minute",    minval=0, maxval=59,    group=SES_GRP)
sesEndH         = input.int(16,     "Session End Hour",        minval=0, maxval=23,    group=SES_GRP)
sesEndM         = input.int(0,      "Session End Minute",      minval=0, maxval=59,    group=SES_GRP)
filterSession   = input.bool(true,  "Signals Only In Session", group=SES_GRP)

// --- Volume Profile ---
VP_GRP          = "Volume Profile"
showVP          = input.bool(true,  "Show Volume Profile",     group=VP_GRP)
vpLookback      = input.int(100,    "VP Lookback (bars)",      minval=20, maxval=500,  group=VP_GRP)
vpRows          = input.int(24,     "VP Rows",                 minval=10, maxval=50,   group=VP_GRP)
vpWidth         = input.int(20,     "VP Width (bars)",         minval=5,  maxval=60,   group=VP_GRP)
vpOpacity       = input.int(75,     "VP Opacity",              minval=30, maxval=95,   group=VP_GRP)

// --- Signals ---
SIG_GRP         = "Signals"
showSignals     = input.bool(true,  "Show Buy/Sell Signals",   group=SIG_GRP)
cooldown        = input.int(20,     "Signal Cooldown (bars)",  minval=1, maxval=100,   group=SIG_GRP)
useRSI          = input.bool(true,  "RSI Filter",              group=SIG_GRP)
rsiOB           = input.int(70,     "RSI Overbought",          minval=55, maxval=95,   group=SIG_GRP)
rsiOS           = input.int(30,     "RSI Oversold",            minval=5, maxval=45,    group=SIG_GRP)
reqTrend        = input.bool(true,  "Require Trend Alignment", group=SIG_GRP, tooltip="BUY only in bull trend, SELL only in bear trend")
reqDelta        = input.bool(true,  "Require Delta Confirm",   group=SIG_GRP, tooltip="Delta must agree with signal direction")
minConfluence   = input.int(4,      "Min Confluence Score",    minval=2, maxval=6,     group=SIG_GRP, tooltip="Out of 6: Trend + AOI + PA + RSI + Session + Delta")
showSLTP        = input.bool(true,  "Show SL/TP on Signal",   group=SIG_GRP)
rrRatio         = input.float(2.0,  "Risk:Reward Ratio",      minval=1.0, maxval=5.0, step=0.5, group=SIG_GRP)
maxSigDraw      = input.int(3,      "Max Signals On Chart",   minval=1, maxval=10,    group=SIG_GRP)

// --- Risk Manager ---
RISK_GRP        = "Risk Manager"
showRisk        = input.bool(true,  "Show Risk Info",          group=RISK_GRP)
accountSize     = input.float(10000,"Account Size (USD)",      minval=100,             group=RISK_GRP)
riskPct         = input.float(1.0,  "Risk per Trade (%)",      minval=0.1, maxval=10,  step=0.1, group=RISK_GRP)
defaultSLAtr    = input.float(1.5,  "Default SL (ATR mult)",   minval=0.5, maxval=5.0, step=0.1, group=RISK_GRP)

// --- Style ---
STY_GRP         = "Style"
colBullish      = input.color(#26A69A, "Bullish",              group=STY_GRP)
colBearish      = input.color(#EF5350, "Bearish",              group=STY_GRP)
colFVG          = input.color(#2962FF, "FVG",                  group=STY_GRP)
colAOI          = input.color(#FF9800, "AOI",                  group=STY_GRP)
colM2           = input.color(#E040FB, "M2 Zone",              group=STY_GRP)
colSession      = input.color(#78909C, "Session",              group=STY_GRP)
colPOC          = input.color(#FF9800, "POC",                  group=STY_GRP)
colLiqDaily     = input.color(#2196F3, "Daily Liq",            group=STY_GRP)
colLiqWeekly    = input.color(#9C27B0, "Weekly Liq",           group=STY_GRP)
colLiqMonthly   = input.color(#FF5722, "Monthly Liq",          group=STY_GRP)
showDash        = input.bool(true,  "Show Dashboard",          group=STY_GRP)

//=====================================================================================================================
// 2. CORE CALCULATIONS
//=====================================================================================================================
atr         = ta.atr(14)
rsi         = ta.rsi(close, 14)
barRange    = high - low
closePos    = barRange > 0 ? (close - low) / barRange : 0.5
buyVol      = volume * closePos
sellVol     = volume * (1.0 - closePos)
rawDelta    = buyVol - sellVol
cumDelta    = ta.sma(rawDelta, 5)

// Session detection
sesStartMin = sesStartH * 60 + sesStartM
sesEndMin   = sesEndH * 60 + sesEndM
curMin      = hour * 60 + minute
inSession   = sesStartMin < sesEndMin ? (curMin >= sesStartMin and curMin < sesEndMin) : (curMin >= sesStartMin or curMin < sesEndMin)

// Price action patterns (strict: only genuine engulfing + pin bars)
body        = math.abs(close - open)
upWick      = high - math.max(close, open)
dnWick      = math.min(close, open) - low
bullEngulf  = close > open and close[1] < open[1] and close > open[1] and open <= close[1] and body > body[1] * 0.5
bearEngulf  = close < open and close[1] > open[1] and close < open[1] and open >= close[1] and body > body[1] * 0.5
bullPin     = dnWick > body * 2.0 and upWick < body * 0.5 and barRange > nz(atr) * 0.3
bearPin     = upWick > body * 2.0 and dnWick < body * 0.5 and barRange > nz(atr) * 0.3
bullPA      = bullEngulf or bullPin
bearPA      = bearEngulf or bearPin

//=====================================================================================================================
// 3. UDT TYPES
//=====================================================================================================================
type Zone
    box     bx
    label   lb
    float   top
    float   bot
    int     dir     // +1 bull, -1 bear
    string  tag     // "FVG", "M2", "AOI", "SR"

type StructPt
    float   price
    int     barIdx
    int     barTm
    bool    crossed

//=====================================================================================================================
// HELPER FUNCTIONS
//=====================================================================================================================
trimZ(array<Zone> zones, int limit) =>
    while array.size(zones) > limit
        old = array.shift(zones)
        box.delete(old.bx)
        label.delete(old.lb)

cleanZ(array<Zone> zones) =>
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            z = array.get(zones, i)
            mitigated = (z.dir == 1 and close < z.bot) or (z.dir == -1 and close > z.top)
            if mitigated
                box.delete(z.bx)
                label.delete(z.lb)
                array.remove(zones, i)

// Trim line+label arrays (for BOS/CHoCH tracking)
var array<line>  structLines  = array.new_line()
var array<label> structLabels = array.new_label()
trimStruct() =>
    while array.size(structLines) > maxStructLabels
        line.delete(array.shift(structLines))
    while array.size(structLabels) > maxStructLabels
        label.delete(array.shift(structLabels))

//=====================================================================================================================
// 4. LIQUIDITY LEVELS
//=====================================================================================================================
// Daily
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead=barmerge.lookahead_on)
// Weekly
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead=barmerge.lookahead_on)
// Monthly
[pmh, pml] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead=barmerge.lookahead_on)

// Persistent liquidity level objects (created once, updated in-place)
var line lnPDH = na, var line lnPDL = na
var line lnPWH = na, var line lnPWL = na
var line lnPMH = na, var line lnPML = na
var label lbPDH = na, var label lbPDL = na
var label lbPWH = na, var label lbPWL = na
var label lbPMH = na, var label lbPML = na

drawLiqLevel(bool show, float lvl, string tag, color col, line ln, label lb) =>
    line  updLn = ln
    label updLb = lb
    if show and not na(lvl)
        if na(updLn)
            updLn  := line.new(bar_index, lvl, bar_index, lvl, color=col, style=line.style_dashed, width=1, extend=extend.both)
            updLb  := label.new(bar_index, lvl, tag + " " + str.tostring(lvl, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=col, style=label.style_label_left, size=size.tiny)
        else
            line.set_y1(updLn, lvl)
            line.set_y2(updLn, lvl)
            line.set_x1(updLn, bar_index - 1)
            line.set_x2(updLn, bar_index)
            label.set_xy(updLb, bar_index + 5, lvl)
            label.set_text(updLb, tag + " " + str.tostring(lvl, format.mintick))
    [updLn, updLb]

[l1, lb1]   = drawLiqLevel(showDaily,   pdh, "PDH", colLiqDaily,   lnPDH, lbPDH)
lnPDH := l1, lbPDH := lb1
[l2, lb2]   = drawLiqLevel(showDaily,   pdl, "PDL", colLiqDaily,   lnPDL, lbPDL)
lnPDL := l2, lbPDL := lb2
[l3, lb3]   = drawLiqLevel(showWeekly,  pwh, "PWH", colLiqWeekly,  lnPWH, lbPWH)
lnPWH := l3, lbPWH := lb3
[l4, lb4]   = drawLiqLevel(showWeekly,  pwl, "PWL", colLiqWeekly,  lnPWL, lbPWL)
lnPWL := l4, lbPWL := lb4
[l5, lb5]   = drawLiqLevel(showMonthly, pmh, "PMH", colLiqMonthly, lnPMH, lbPMH)
lnPMH := l5, lbPMH := lb5
[l6, lb6]   = drawLiqLevel(showMonthly, pml, "PML", colLiqMonthly, lnPML, lbPML)
lnPML := l6, lbPML := lb6

//=====================================================================================================================
// 5. MARKET STRUCTURE (BOS / CHoCH)
//=====================================================================================================================
var StructPt swHigh     = StructPt.new(na, na, na, false)
var StructPt swLow      = StructPt.new(na, na, na, false)
var int      trendBias  = 0  // +1 bull, -1 bear

// Detect swing points
sH = ta.pivothigh(high, structLen, structLen)
sL = ta.pivotlow(low, structLen, structLen)

if not na(sH)
    swHigh.price    := sH
    swHigh.barIdx   := bar_index - structLen
    swHigh.barTm    := time[structLen]
    swHigh.crossed  := false

if not na(sL)
    swLow.price     := sL
    swLow.barIdx    := bar_index - structLen
    swLow.barTm     := time[structLen]
    swLow.crossed   := false

// BOS / CHoCH detection
bosUp       = false
bosDown     = false
chochUp     = false
chochDown   = false

if not na(swHigh.price) and not swHigh.crossed and ta.crossover(close, swHigh.price)
    swHigh.crossed := true
    if trendBias == -1 or trendBias == 0
        chochUp := true
    else
        bosUp := true
    trendBias := 1

if not na(swLow.price) and not swLow.crossed and ta.crossunder(close, swLow.price)
    swLow.crossed := true
    if trendBias == 1 or trendBias == 0
        chochDown := true
    else
        bosDown := true
    trendBias := -1

// Draw structure -- tracked in arrays with trim to avoid hitting object limits
if showStructure
    if bosUp and not na(swHigh.price)
        array.push(structLines, line.new(swHigh.barIdx, swHigh.price, bar_index, swHigh.price, color=colBullish, style=line.style_solid, width=1))
        array.push(structLabels, label.new(math.round(math.avg(swHigh.barIdx, bar_index)), swHigh.price, "BOS", xloc.bar_index, yloc.price, color=color(na), textcolor=colBullish, style=label.style_label_down, size=size.tiny))
        trimStruct()

    if bosDown and not na(swLow.price)
        array.push(structLines, line.new(swLow.barIdx, swLow.price, bar_index, swLow.price, color=colBearish, style=line.style_solid, width=1))
        array.push(structLabels, label.new(math.round(math.avg(swLow.barIdx, bar_index)), swLow.price, "BOS", xloc.bar_index, yloc.price, color=color(na), textcolor=colBearish, style=label.style_label_up, size=size.tiny))
        trimStruct()

    if chochUp and not na(swHigh.price)
        array.push(structLines, line.new(swHigh.barIdx, swHigh.price, bar_index, swHigh.price, color=colBullish, style=line.style_dashed, width=1))
        array.push(structLabels, label.new(math.round(math.avg(swHigh.barIdx, bar_index)), swHigh.price, "CHoCH", xloc.bar_index, yloc.price, color=color(na), textcolor=colBullish, style=label.style_label_down, size=size.tiny))
        trimStruct()

    if chochDown and not na(swLow.price)
        array.push(structLines, line.new(swLow.barIdx, swLow.price, bar_index, swLow.price, color=colBearish, style=line.style_dashed, width=1))
        array.push(structLabels, label.new(math.round(math.avg(swLow.barIdx, bar_index)), swLow.price, "CHoCH", xloc.bar_index, yloc.price, color=color(na), textcolor=colBearish, style=label.style_label_up, size=size.tiny))
        trimStruct()

//=====================================================================================================================
// 6. M2 ZONES  (extend=extend.right -- zones stretch to chart edge until mitigated)
//=====================================================================================================================
var array<Zone> m2Zones = array.new<Zone>()
m2half = math.max(nz(atr) * aoiAtrMult, syminfo.mintick * 3)

if showM2 and (bosUp or chochUp) and not na(swLow.price)
    t = swLow.price + m2half
    bt = swLow.price - m2half
    b = box.new(swLow.barIdx, t, swLow.barIdx, bt, bgcolor=color.new(colM2, 85), border_color=color.new(colM2, 40), extend=extend.right)
    lb = label.new(swLow.barIdx, bt, "M2 " + str.tostring(swLow.price, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colM2, style=label.style_label_left, size=size.tiny)
    array.push(m2Zones, Zone.new(b, lb, t, bt, 1, "M2"))
    trimZ(m2Zones, 6)

if showM2 and (bosDown or chochDown) and not na(swHigh.price)
    t = swHigh.price + m2half
    bt = swHigh.price - m2half
    b = box.new(swHigh.barIdx, t, swHigh.barIdx, bt, bgcolor=color.new(colM2, 85), border_color=color.new(colM2, 40), extend=extend.right)
    lb = label.new(swHigh.barIdx, t, "M2 " + str.tostring(swHigh.price, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colM2, style=label.style_label_left, size=size.tiny)
    array.push(m2Zones, Zone.new(b, lb, t, bt, -1, "M2"))
    trimZ(m2Zones, 6)

// M2 from Higher TF
[htfSH, htfSL, htfClose, htfHigh, htfLow] = request.security(syminfo.tickerid, htfM2, [ta.pivothigh(high, structLen, structLen), ta.pivotlow(low, structLen, structLen), close, high, low])

var float lastHTFHigh = na
var float lastHTFLow  = na

if showM2 and not na(htfSH) and (na(lastHTFHigh) or htfSH != lastHTFHigh)
    lastHTFHigh := htfSH
    t = htfSH + m2half * 2
    bt = htfSH - m2half * 2
    b = box.new(bar_index, t, bar_index, bt, bgcolor=color.new(colM2, 90), border_color=color.new(colM2, 55), extend=extend.right)
    lb = label.new(bar_index, t, "HTF M2 " + str.tostring(htfSH, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colM2, style=label.style_label_left, size=size.tiny)
    array.push(m2Zones, Zone.new(b, lb, t, bt, -1, "M2"))
    trimZ(m2Zones, 6)

if showM2 and not na(htfSL) and (na(lastHTFLow) or htfSL != lastHTFLow)
    lastHTFLow := htfSL
    t = htfSL + m2half * 2
    bt = htfSL - m2half * 2
    b = box.new(bar_index, t, bar_index, bt, bgcolor=color.new(colM2, 90), border_color=color.new(colM2, 55), extend=extend.right)
    lb = label.new(bar_index, bt, "HTF M2 " + str.tostring(htfSL, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colM2, style=label.style_label_left, size=size.tiny)
    array.push(m2Zones, Zone.new(b, lb, t, bt, 1, "M2"))
    trimZ(m2Zones, 6)

cleanZ(m2Zones)

//=====================================================================================================================
// 7. AOI (Area of Interest) = FVG + Pivot confluence  (extend=extend.right)
//=====================================================================================================================
var array<Zone> aoiZones = array.new<Zone>()
aoiHalf = math.max(nz(atr) * aoiAtrMult, syminfo.mintick * 3)

// FVG detection -> AOI (requires min size + optional confluence filter)
// Helper: check if price level is near any M2 zone or liquidity level
isNearM2(float mid) =>
    found = false
    if array.size(m2Zones) > 0
        for k = 0 to array.size(m2Zones) - 1
            mz = array.get(m2Zones, k)
            if math.abs(mid - math.avg(mz.top, mz.bot)) < nz(atr) * 1.5
                found := true
                break
    found

isNearLiq(float mid) =>
    nearD = (showDaily   and (math.abs(mid - nz(pdh)) < nz(atr) or math.abs(mid - nz(pdl)) < nz(atr)))
    nearW = (showWeekly  and (math.abs(mid - nz(pwh)) < nz(atr) or math.abs(mid - nz(pwl)) < nz(atr)))
    nearM = (showMonthly and (math.abs(mid - nz(pmh)) < nz(atr) or math.abs(mid - nz(pml)) < nz(atr)))
    nearD or nearW or nearM

if showAOI and showFVG and bar_index > 2
    if low > high[2]
        gapSize = low - high[2]
        t = low
        bt = high[2]
        mid = math.avg(t, bt)
        hasConf = isNearM2(mid) or isNearLiq(mid)
        sizeOk  = gapSize > nz(atr) * minFVGSize
        passFilter = sizeOk and (not fvgConfluence or hasConf)
        if passFilter
            conf = hasConf ? (isNearM2(mid) ? " +M2" : " +LIQ") : ""
            tag = "AOI FVG" + conf
            b = box.new(bar_index - 2, t, bar_index - 2, bt, bgcolor=color.new(colAOI, 85), border_color=color.new(colAOI, 40), extend=extend.right)
            lb = label.new(bar_index - 2, mid, tag, xloc.bar_index, yloc.price, color=color(na), textcolor=colAOI, style=label.style_label_left, size=size.tiny)
            array.push(aoiZones, Zone.new(b, lb, t, bt, 1, "AOI"))
            trimZ(aoiZones, maxAOI)

    if high < low[2]
        gapSize = low[2] - high
        t = low[2]
        bt = high
        mid = math.avg(t, bt)
        hasConf = isNearM2(mid) or isNearLiq(mid)
        sizeOk  = gapSize > nz(atr) * minFVGSize
        passFilter = sizeOk and (not fvgConfluence or hasConf)
        if passFilter
            conf = hasConf ? (isNearM2(mid) ? " +M2" : " +LIQ") : ""
            tag = "AOI FVG" + conf
            b = box.new(bar_index - 2, t, bar_index - 2, bt, bgcolor=color.new(colAOI, 85), border_color=color.new(colAOI, 40), extend=extend.right)
            lb = label.new(bar_index - 2, mid, tag, xloc.bar_index, yloc.price, color=color(na), textcolor=colAOI, style=label.style_label_left, size=size.tiny)
            array.push(aoiZones, Zone.new(b, lb, t, bt, -1, "AOI"))
            trimZ(aoiZones, maxAOI)

// Pivot S/R -> AOI (skip if already covered by an M2 zone)
// Helper: check if price overlaps an existing M2 zone; if yes, upgrade M2 label
isOverlapM2(float price) =>
    overlap = false
    if array.size(m2Zones) > 0
        for k = 0 to array.size(m2Zones) - 1
            mz = array.get(m2Zones, k)
            if price >= mz.bot and price <= mz.top
                overlap := true
                // Upgrade M2 label to show confluence
                curTxt = label.get_text(mz.lb)
                if not str.contains(curTxt, "+S") and not str.contains(curTxt, "+R")
                    label.set_text(mz.lb, curTxt + " +S/R")
                break
    overlap

if showAOI and showPivotLiq
    pHi = ta.pivothigh(high, pivotLen, pivotLen)
    pLo = ta.pivotlow(low, pivotLen, pivotLen)
    swHOk = not na(swLow.price)
    swLOk = not na(swHigh.price)
    swingOk_h = na(pHi) ? false : (minSwingSize == 0.0 or (swHOk and pHi - swLow.price > nz(atr) * minSwingSize))
    swingOk_l = na(pLo) ? false : (minSwingSize == 0.0 or (swLOk and swHigh.price - pLo > nz(atr) * minSwingSize))

    if not na(pHi) and swingOk_h
        if not isOverlapM2(pHi)
            t = pHi + aoiHalf
            bt = pHi - aoiHalf
            b = box.new(bar_index - pivotLen, t, bar_index - pivotLen, bt, bgcolor=color.new(colBearish, 88), border_color=color.new(colBearish, 50), extend=extend.right)
            lb = label.new(bar_index - pivotLen, t, "AOI R " + str.tostring(pHi, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colBearish, style=label.style_label_left, size=size.tiny)
            array.push(aoiZones, Zone.new(b, lb, t, bt, -1, "AOI"))
            trimZ(aoiZones, maxAOI)

    if not na(pLo) and swingOk_l
        if not isOverlapM2(pLo)
            t = pLo + aoiHalf
            bt = pLo - aoiHalf
            b = box.new(bar_index - pivotLen, t, bar_index - pivotLen, bt, bgcolor=color.new(colBullish, 88), border_color=color.new(colBullish, 50), extend=extend.right)
            lb = label.new(bar_index - pivotLen, bt, "AOI S " + str.tostring(pLo, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colBullish, style=label.style_label_left, size=size.tiny)
            array.push(aoiZones, Zone.new(b, lb, t, bt, 1, "AOI"))
            trimZ(aoiZones, maxAOI)

// Clean mitigated AOIs
if showAOI
    cleanZ(aoiZones)

//=====================================================================================================================
// 8. SESSION ENVELOPE
//=====================================================================================================================
var float sesHigh   = na
var float sesLow    = na
var bool  prevInSes = false
var box   sesBox    = na
var label sesLbl    = na

sesStart = inSession and not prevInSes

if showSession
    if sesStart
        sesHigh := high
        sesLow  := low
        box.delete(sesBox)
        label.delete(sesLbl)
        sesBox := box.new(bar_index, high, bar_index, low, bgcolor=color.new(colSession, 92), border_color=color.new(colSession, 60))

    if inSession
        sesHigh := math.max(nz(sesHigh, high), high)
        sesLow  := math.min(nz(sesLow, low), low)
        if not na(sesBox)
            box.set_top(sesBox, sesHigh)
            box.set_bottom(sesBox, sesLow)
            box.set_right(sesBox, bar_index)

    if sesStart
        sesLbl := label.new(bar_index, sesHigh, "Session", xloc.bar_index, yloc.price, color=color(na), textcolor=colSession, style=label.style_label_down, size=size.tiny)

prevInSes := inSession

//=====================================================================================================================
// 9. VOLUME PROFILE (horizontal bars on Y-axis)
//=====================================================================================================================
var array<box> vpBuyBoxes  = array.new_box()
var array<box> vpSellBoxes = array.new_box()
var line       pocLine     = na
var label      pocLbl      = na
var float      pocPrice    = na

if showVP and (barstate.islastconfirmedhistory or barstate.islast)
    if array.size(vpBuyBoxes) > 0
        for i = 0 to array.size(vpBuyBoxes) - 1
            box.delete(array.get(vpBuyBoxes, i))
    if array.size(vpSellBoxes) > 0
        for i = 0 to array.size(vpSellBoxes) - 1
            box.delete(array.get(vpSellBoxes, i))
    array.clear(vpBuyBoxes)
    array.clear(vpSellBoxes)
    line.delete(pocLine)
    label.delete(pocLbl)

    lookback = math.min(vpLookback, bar_index)
    if lookback > 1
        hiP = ta.highest(high, lookback)
        loP = ta.lowest(low, lookback)
        pRange = hiP - loP

        if pRange > 0
            binSz = pRange / vpRows
            var array<float> bBuy  = array.new_float(vpRows, 0.0)
            var array<float> bSell = array.new_float(vpRows, 0.0)
            array.fill(bBuy, 0.0)
            array.fill(bSell, 0.0)

            for j = 0 to lookback - 1
                bin = math.floor((close[j] - loP) / binSz)
                bin := math.max(0, math.min(bin, vpRows - 1))
                array.set(bBuy, bin, array.get(bBuy, bin) + nz(buyVol[j]))
                array.set(bSell, bin, array.get(bSell, bin) + nz(sellVol[j]))

            maxV = 0.0
            pocBin = 0
            for i = 0 to vpRows - 1
                tv = array.get(bBuy, i) + array.get(bSell, i)
                if tv > maxV
                    maxV := tv
                    pocBin := i

            if maxV > 0
                for i = 0 to vpRows - 1
                    bv = array.get(bBuy, i)
                    sv = array.get(bSell, i)
                    tv = bv + sv
                    if tv > 0
                        binTop = loP + (i + 1) * binSz
                        binBot = loP + i * binSz
                        bw = math.round((tv / maxV) * vpWidth)
                        buyW = math.round((bv / tv) * bw)
                        sellW = bw - buyW
                        if buyW > 0
                            array.push(vpBuyBoxes, box.new(bar_index + 2, binTop, bar_index + 2 + buyW, binBot, bgcolor=color.new(colBullish, vpOpacity), border_color=color(na)))
                        if sellW > 0
                            array.push(vpSellBoxes, box.new(bar_index + 2 + buyW, binTop, bar_index + 2 + bw, binBot, bgcolor=color.new(colBearish, vpOpacity), border_color=color(na)))

                pocPrice := loP + (pocBin + 0.5) * binSz
                pocLine  := line.new(bar_index - lookback, pocPrice, bar_index + 2, pocPrice, color=colPOC, style=line.style_dashed, width=1)
                pocLbl   := label.new(bar_index + 3, pocPrice, "POC", xloc.bar_index, yloc.price, color=color(na), textcolor=colPOC, style=label.style_label_left, size=size.tiny)

//=====================================================================================================================
// 10. SIGNAL ENGINE (confluence-based, with visual explanation)
//=====================================================================================================================
nearBull    = false
nearBear    = false
bullZoneTag = ""
bearZoneTag = ""

// Check AOI zones -- find the closest touched zone name
if array.size(aoiZones) > 0
    for i = 0 to array.size(aoiZones) - 1
        z = array.get(aoiZones, i)
        if z.dir == 1 and low <= z.top and close > z.bot
            nearBull := true
            if bullZoneTag == ""
                bullZoneTag := z.tag
        if z.dir == -1 and high >= z.bot and close < z.top
            nearBear := true
            if bearZoneTag == ""
                bearZoneTag := z.tag

// Check M2 zones
if array.size(m2Zones) > 0
    for i = 0 to array.size(m2Zones) - 1
        z = array.get(m2Zones, i)
        if z.dir == 1 and low <= z.top and close > z.bot
            nearBull := true
            if bullZoneTag == ""
                bullZoneTag := "M2"
        if z.dir == -1 and high >= z.bot and close < z.top
            nearBear := true
            if bearZoneTag == ""
                bearZoneTag := "M2"

// Identify PA type
bullPAType  = bullEngulf ? "Engulfing" : bullPin ? "Pin Bar" : ""
bearPAType  = bearEngulf ? "Engulfing" : bearPin ? "Pin Bar" : ""

// Confluence scoring: each factor = 1 point
buyTrend    = trendBias == 1
buyAOI      = nearBull
buyPAok     = bullPA
buyRSI      = not useRSI or rsi < rsiOB
buySes      = not filterSession or inSession
buyDelta    = cumDelta > 0
buyScore    = (buyTrend ? 1 : 0) + (buyAOI ? 1 : 0) + (buyPAok ? 1 : 0) + (buyRSI ? 1 : 0) + (buySes ? 1 : 0) + (buyDelta ? 1 : 0)

sellTrend   = trendBias == -1
sellAOI     = nearBear
sellPAok    = bearPA
sellRSI     = not useRSI or rsi > rsiOS
sellSes     = not filterSession or inSession
sellDelta   = cumDelta < 0
sellScore   = (sellTrend ? 1 : 0) + (sellAOI ? 1 : 0) + (sellPAok ? 1 : 0) + (sellRSI ? 1 : 0) + (sellSes ? 1 : 0) + (sellDelta ? 1 : 0)

// Hard requirements
buyHard     = buyAOI and buyPAok and (not reqTrend or buyTrend) and (not reqDelta or buyDelta)
sellHard    = sellAOI and sellPAok and (not reqTrend or sellTrend) and (not reqDelta or sellDelta)

var int lastBuy  = na
var int lastSell = na
buyOk  = na(lastBuy)  or (bar_index - lastBuy  >= cooldown)
sellOk = na(lastSell) or (bar_index - lastSell >= cooldown)

buySig  = showSignals and buyHard and buyScore >= minConfluence and buyOk
sellSig = showSignals and sellHard and sellScore >= minConfluence and sellOk

if buySig
    lastBuy := bar_index
if sellSig
    lastSell := bar_index

//---------------------------------------------------------------------------------------------------------------------
// 10b. SIGNAL DRAWING (rich labels + SL/TP lines)
//---------------------------------------------------------------------------------------------------------------------
// Arrays to track signal drawings for cleanup
var array<label> sigLabels  = array.new_label()
var array<line>  sigLines   = array.new_line()

// Trim old signal drawings (each signal = 4 labels + 4 lines)
trimSigDraw() =>
    maxLbl = maxSigDraw * 4
    maxLns = maxSigDraw * 4
    while array.size(sigLabels) > maxLbl
        label.delete(array.shift(sigLabels))
    while array.size(sigLines) > maxLns
        line.delete(array.shift(sigLines))

// Build compact signal label (2 lines: direction + score, zone + PA)
buildLabel(bool isBuy, int score, string zoneTag, string paType) =>
    dir = isBuy ? "▲ BUY " : "▼ SELL "
    dir + str.tostring(score) + "/6\n" + zoneTag + " + " + paType

if buySig and showSignals
    txt = buildLabel(true, buyScore, bullZoneTag, bullPAType)
    array.push(sigLabels, label.new(bar_index, low, txt, xloc.bar_index, yloc.price, color=colBullish, textcolor=color.white, style=label.style_label_up, size=size.normal))
    if showSLTP
        entry   = close
        sl      = entry - nz(atr) * defaultSLAtr
        tp1     = entry + (entry - sl) * rrRatio
        tp2     = entry + (entry - sl) * (rrRatio + 1.0)
        lineLen = 15
        array.push(sigLines, line.new(bar_index, entry, bar_index + lineLen, entry, color=colBullish, style=line.style_solid, width=2))
        array.push(sigLines, line.new(bar_index, sl,    bar_index + lineLen, sl,    color=colBearish, style=line.style_dashed, width=2))
        array.push(sigLines, line.new(bar_index, tp1,   bar_index + lineLen, tp1,   color=colBullish, style=line.style_dotted, width=2))
        array.push(sigLines, line.new(bar_index, tp2,   bar_index + lineLen, tp2,   color=colBullish, style=line.style_dotted, width=2))
        // SL/TP price labels
        array.push(sigLabels, label.new(bar_index + lineLen, sl,  "SL " + str.tostring(sl, format.mintick),  xloc.bar_index, yloc.price, color=color(na), textcolor=colBearish, style=label.style_label_left, size=size.small))
        array.push(sigLabels, label.new(bar_index + lineLen, tp1, "TP1 " + str.tostring(tp1, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colBullish, style=label.style_label_left, size=size.small))
        array.push(sigLabels, label.new(bar_index + lineLen, tp2, "TP2 " + str.tostring(tp2, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colBullish, style=label.style_label_left, size=size.small))
    trimSigDraw()

if sellSig and showSignals
    txt = buildLabel(false, sellScore, bearZoneTag, bearPAType)
    array.push(sigLabels, label.new(bar_index, high, txt, xloc.bar_index, yloc.price, color=colBearish, textcolor=color.white, style=label.style_label_down, size=size.normal))
    if showSLTP
        entry   = close
        sl      = entry + nz(atr) * defaultSLAtr
        tp1     = entry - (sl - entry) * rrRatio
        tp2     = entry - (sl - entry) * (rrRatio + 1.0)
        lineLen = 15
        array.push(sigLines, line.new(bar_index, entry, bar_index + lineLen, entry, color=colBearish, style=line.style_solid, width=2))
        array.push(sigLines, line.new(bar_index, sl,    bar_index + lineLen, sl,    color=colBullish, style=line.style_dashed, width=2))
        array.push(sigLines, line.new(bar_index, tp1,   bar_index + lineLen, tp1,   color=colBearish, style=line.style_dotted, width=2))
        array.push(sigLines, line.new(bar_index, tp2,   bar_index + lineLen, tp2,   color=colBearish, style=line.style_dotted, width=2))
        array.push(sigLabels, label.new(bar_index + lineLen, sl,  "SL " + str.tostring(sl, format.mintick),  xloc.bar_index, yloc.price, color=color(na), textcolor=colBullish, style=label.style_label_left, size=size.small))
        array.push(sigLabels, label.new(bar_index + lineLen, tp1, "TP1 " + str.tostring(tp1, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colBearish, style=label.style_label_left, size=size.small))
        array.push(sigLabels, label.new(bar_index + lineLen, tp2, "TP2 " + str.tostring(tp2, format.mintick), xloc.bar_index, yloc.price, color=color(na), textcolor=colBearish, style=label.style_label_left, size=size.small))
    trimSigDraw()

// Plotshape for alert compatibility
plotshape(buySig,  "BUY",  shape.triangleup,   location.belowbar, color.new(colBullish, 0), size=size.tiny)
plotshape(sellSig, "SELL", shape.triangledown,  location.abovebar, color.new(colBearish, 0), size=size.tiny)

//=====================================================================================================================
// 11. RISK MANAGER
//=====================================================================================================================
slPoints    = nz(atr) * defaultSLAtr
slPrice_b   = close - slPoints
slPrice_s   = close + slPoints
riskUSD     = accountSize * (riskPct / 100.0)
pipValue    = syminfo.mintick * 10
slPips      = pipValue > 0 ? slPoints / pipValue : 0.0
posSize     = slPips > 0 and pipValue > 0 ? riskUSD / (slPips * pipValue) : 0.0

//=====================================================================================================================
// 12. CHECKLIST DASHBOARD
//=====================================================================================================================
// Track last signal info for dashboard
var string lastSigDir   = "—"
var int    lastSigScore  = 0
var int    lastSigBar    = 0
var string lastSigZone   = ""
var string lastSigPA     = ""

if buySig
    lastSigDir   := "BUY"
    lastSigScore := buyScore
    lastSigBar   := bar_index
    lastSigZone  := bullZoneTag
    lastSigPA    := bullPAType

if sellSig
    lastSigDir   := "SELL"
    lastSigScore := sellScore
    lastSigBar   := bar_index
    lastSigZone  := bearZoneTag
    lastSigPA    := bearPAType

if showDash and barstate.islast
    var table dash = table.new(position.top_right, 3, 11, bgcolor=color.new(color.black, 75), border_width=1)

    // Header
    table.cell(dash, 0, 0, "SmartZone Algo", text_color=color.white, bgcolor=color.new(#1565C0, 40), text_size=size.small)
    table.cell(dash, 1, 0, "",               text_color=color.white, bgcolor=color.new(#1565C0, 40))
    table.cell(dash, 2, 0, "Checklist",      text_color=color.white, bgcolor=color.new(#1565C0, 40), text_size=size.small)

    // --- Current conditions ---
    // Trend
    trendTxt = trendBias == 1 ? "BULL" : trendBias == -1 ? "BEAR" : "—"
    trendCol = trendBias == 1 ? colBullish : trendBias == -1 ? colBearish : color.gray
    table.cell(dash, 0, 1, "Trend",  text_color=color.white, bgcolor=color.new(color.gray, 65), text_size=size.small)
    table.cell(dash, 1, 1, trendTxt, text_color=trendCol, text_size=size.small)
    table.cell(dash, 2, 1, trendBias != 0 ? "✓" : "✗", text_color=trendBias != 0 ? colBullish : colBearish, text_size=size.small)

    // Zone
    aoiHit = nearBull or nearBear
    aoiTxt = nearBull ? bullZoneTag : nearBear ? bearZoneTag : "—"
    table.cell(dash, 0, 2, "Zone",    text_color=color.white, bgcolor=color.new(color.gray, 65), text_size=size.small)
    table.cell(dash, 1, 2, aoiHit ? aoiTxt : "—", text_color=aoiHit ? colAOI : color.gray, text_size=size.small)
    table.cell(dash, 2, 2, aoiHit ? "✓" : "✗", text_color=aoiHit ? colBullish : colBearish, text_size=size.small)

    // PA
    paHit = bullPA or bearPA
    paTxt = bullPA ? bullPAType : bearPA ? bearPAType : "—"
    table.cell(dash, 0, 3, "PA",      text_color=color.white, bgcolor=color.new(color.gray, 65), text_size=size.small)
    table.cell(dash, 1, 3, paHit ? paTxt : "—", text_color=paHit ? (bullPA ? colBullish : colBearish) : color.gray, text_size=size.small)
    table.cell(dash, 2, 3, paHit ? "✓" : "✗", text_color=paHit ? colBullish : colBearish, text_size=size.small)

    // RSI
    rsiTxt = str.tostring(rsi, "#.#")
    rsiCol = rsi > rsiOB ? colBearish : rsi < rsiOS ? colBullish : color.white
    rsiChk = rsi < rsiOB and rsi > rsiOS
    table.cell(dash, 0, 4, "RSI",     text_color=color.white, bgcolor=color.new(color.gray, 65), text_size=size.small)
    table.cell(dash, 1, 4, rsiTxt,    text_color=rsiCol, text_size=size.small)
    table.cell(dash, 2, 4, rsiChk ? "✓" : "✗", text_color=rsiChk ? colBullish : colBearish, text_size=size.small)

    // Session
    table.cell(dash, 0, 5, "Session", text_color=color.white, bgcolor=color.new(color.gray, 65), text_size=size.small)
    table.cell(dash, 1, 5, inSession ? "ACTIVE" : "CLOSED", text_color=inSession ? colBullish : color.gray, text_size=size.small)
    table.cell(dash, 2, 5, inSession ? "✓" : "✗", text_color=inSession ? colBullish : colBearish, text_size=size.small)

    // Delta
    deltaTxt = cumDelta > 0 ? "BUYERS" : cumDelta < 0 ? "SELLERS" : "—"
    deltaCol = cumDelta > 0 ? colBullish : cumDelta < 0 ? colBearish : color.gray
    table.cell(dash, 0, 6, "Delta",   text_color=color.white, bgcolor=color.new(color.gray, 65), text_size=size.small)
    table.cell(dash, 1, 6, deltaTxt,  text_color=deltaCol, text_size=size.small)
    table.cell(dash, 2, 6, cumDelta != 0 ? "✓" : "✗", text_color=cumDelta != 0 ? colBullish : colBearish, text_size=size.small)

    // --- Confluence score ---
    curScore = nearBull ? buyScore : nearBear ? sellScore : 0
    scoreTxt = str.tostring(curScore) + " / 6"
    scoreCol = curScore >= minConfluence ? colBullish : curScore >= 3 ? colAOI : colBearish
    table.cell(dash, 0, 7, "Score",   text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.normal)
    table.cell(dash, 1, 7, scoreTxt,  text_color=scoreCol, text_size=size.large)
    table.cell(dash, 2, 7, curScore >= minConfluence ? "READY" : "WAIT", text_color=curScore >= minConfluence ? colBullish : colBearish, text_size=size.normal)

    // --- Last signal summary ---
    table.cell(dash, 0, 8, "Last Sig", text_color=color.white, bgcolor=color.new(#1565C0, 50), text_size=size.small)
    sigCol = lastSigDir == "BUY" ? colBullish : lastSigDir == "SELL" ? colBearish : color.gray
    barsAgo = lastSigBar > 0 ? bar_index - lastSigBar : 0
    sigTxt  = lastSigDir + " " + str.tostring(lastSigScore) + "/6"
    table.cell(dash, 1, 8, sigTxt,   text_color=sigCol, text_size=size.small)
    table.cell(dash, 2, 8, barsAgo > 0 ? str.tostring(barsAgo) + " bars ago" : "", text_color=color.gray, text_size=size.small)

    table.cell(dash, 0, 9, "Reason", text_color=color.white, bgcolor=color.new(#1565C0, 50), text_size=size.small)
    table.cell(dash, 1, 9, lastSigZone != "" ? lastSigZone + " + " + lastSigPA : "—", text_color=color.white, text_size=size.small)
    table.cell(dash, 2, 9, "",       text_color=color.white, text_size=size.small)

    // --- Risk Manager ---
    if showRisk
        riskTxt = "Size: " + str.tostring(posSize, "#.##") + " | SL: " + str.tostring(slPips, "#.#") + " pips | Risk: $" + str.tostring(riskUSD, "#.##")
        table.cell(dash, 0, 10, "Risk", text_color=color.white, bgcolor=color.new(color.gray, 40), text_size=size.small)
        table.cell(dash, 1, 10, riskTxt, text_color=color.white, text_size=size.small)
        table.cell(dash, 2, 10, "",     text_color=color.white, text_size=size.small)

//=====================================================================================================================
// 13. ALERTS
//=====================================================================================================================
fvgBull = low > high[2] and (low - high[2]) > nz(atr) * minFVGSize
fvgBear = high < low[2] and (low[2] - high) > nz(atr) * minFVGSize
newAOI  = showAOI and showFVG and bar_index > 2 and (fvgBull or fvgBear)
alertcondition(newAOI,               "New AOI Zone",   "New AOI zone formed")
alertcondition(nearBull or nearBear, "AOI Touch",      "Price touched AOI zone")
alertcondition(buySig,               "BUY Signal",     "SmartZone BUY signal")
alertcondition(sellSig,              "SELL Signal",    "SmartZone SELL signal")
alertcondition(chochUp or chochDown, "CHoCH",          "Change of Character detected")
alertcondition(bosUp or bosDown,     "BOS",            "Break of Structure detected")
